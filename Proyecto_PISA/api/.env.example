# Plantilla de configuración de la API. Copiarla como .env (que NO se sube a Git) y ajustar si hace falta.
# Sin .env, la API usa estos mismos valores por defecto (ver app/config.py).

# URL de SQLAlchemy de la base con los resultados cargados (python -m app.carga la crea)
PISA_URL_BASE_DATOS=sqlite:///pisa_resultados.db

# Carpeta con los CSV agregados que produce la cadena de R
PISA_CARPETA_SALIDAS=../salidas

# DEBUG, INFO, WARNING o ERROR
PISA_NIVEL_LOG=INFO
