# Plantilla de configuración del tablero. Copiarla como .env (que NO se sube a Git) y ajustar si hace falta.

# URL base de la API, sin /v1 (en local, la de uvicorn; desplegado, la URL pública de la API)
PISA_API_URL=http://127.0.0.1:8000

# Tiempo máximo de espera por petición (s) e intentos ante fallos de red o 5xx
PISA_API_TIMEOUT=10
PISA_API_INTENTOS=3
